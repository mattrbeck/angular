// Module settings match tsconfig.build.json: `ng-exp-compiler` ships ESM only, and the
// language service is emitted into it as the ./language-service entrypoint. Compiling
// this half as CommonJS also put `src/analyzer_loader.ts` — reached from
// tests/test_helpers.ts via NapiAnalyzer — into a program where `import.meta` is
// illegal.
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "../../..",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "jasmine"],
    "paths": {
      "angular-in-memory-web-api": ["../../../misc/angular-in-memory-web-api/index"],
      "@angular/*": ["../../../*/index"],
      "@angular/common/locales/*": ["../../../common/locales/*"],
      "@angular/compiler-cli": ["../../../compiler-cli"],
      "@angular/compiler-cli/*": ["../../../compiler-cli/*"],
      "@angular/compiler-cli/src/ngtsc/reflection": [
        "../../../compiler-cli/src/ngtsc/reflection/index"
      ],
      "@angular/compiler-cli/src/ngtsc/metadata": [
        "../../../compiler-cli/src/ngtsc/metadata/index"
      ],
      "@angular/compiler-cli/private/migrations": ["../../../compiler-cli/private/migrations"],
      "@angular/language-service/private": ["../../../language-service/private"],
      "@angular/language-service/api": ["../../../language-service/api"],
      "@angular/language-service": ["../../../language-service/api"],
      "@angular/core/schematics/utils/tsurge/*": ["../../../core/schematics/utils/tsurge/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["tests/test-workspace/**/*.ts"]
}
