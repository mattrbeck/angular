{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "PipeFunctionCallsSchema",
  "title": "Pipe Function Calls Migration Schema",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "description": "Path to the directory or file to migrate, relative to project root.",
      "$default": {
        "$source": "workingDirectory"
      }
    },
    "format": {
      "type": "boolean",
      "description": "Whether to format modified templates with Prettier.",
      "default": true
    }
  },
  "additionalProperties": false
}
